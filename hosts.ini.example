[routers]
router-01 ansible_host=localhost ansible_port=2221 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_extra_args='-o StrictHostKeyChecking=no'
router-02 ansible_host=localhost ansible_port=2222 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_extra_args='-o StrictHostKeyChecking=no'

[switches]
switch-01 ansible_host=localhost ansible_port=2223 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_extra_args='-o StrictHostKeyChecking=no'
switch-02 ansible_host=localhost ansible_port=2224 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_extra_args='-o StrictHostKeyChecking=no'

[firewalls]
firewall-01 ansible_host=localhost ansible_port=2225 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_extra_args='-o StrictHostKeyChecking=no'

[network_devices:children]
routers
switches
firewalls

# ============================================================
# Cisco DevNet Sandbox devices
# Register at: developer.cisco.com/sandbox
# Uncomment and fill in your sandbox credentials
# ============================================================
# [cisco_devices]
# sandbox-ios-xe ansible_host=sandbox-iosxe-latest-1.cisco.com
#                ansible_port=22
#                ansible_user=developer
#                ansible_password=C1sco12345
#                ansible_connection=network_cli
#                ansible_network_os=cisco.ios.ios
#                ansible_become=true
#                ansible_become_method=enable

[cisco_devices]
cat8000v ansible_host=YOUR_SANDBOX_IP ansible_port=22 ansible_user=YOUR_USER ansible_password=YOUR_PASSWORD ansible_connection=network_cli ansible_network_os=cisco.ios.ios ansible_become=true ansible_become_method=enable